# ===== 应用配置 =====
APP_NAME=StudyFlow Agent
# development / production（生产环境务必把 DEBUG 关掉）
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 前端构建产物目录（默认自动找 ../frontend/dist，单服务部署时由后端托管页面）
# FRONTEND_DIST=/app/frontend/dist

# ===== 安全配置 =====
# 公网部署请换成随机长串（可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成）
SECRET_KEY=please-change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 数据库 =====
# 开发环境默认 SQLite，可平滑切换到 MySQL
DATABASE_URL=sqlite:///../data/studyflow.db
# 容器/云托管建议用绝对路径挂持久盘，例如：
# DATABASE_URL=sqlite:////app/data/studyflow.db
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/studyflow?charset=utf8mb4

# ===== LLM 配置（OpenAI 兼容） =====
# 留空则自动降级为内置题库 + 规则式讲解，功能仍可完整体验
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Embedding 配置 =====
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ===== RAG 配置 =====
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=../data/chroma
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== 文件上传 =====
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_SIZE_MB=20

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=../data/logs

# ===== CORS =====
# 同源部署（后端同时托管前端）无需额外配置；
# 前后端分离部署时把前端域名填进列表，或直接 ["*"]（凭证请求会关闭，本项目用 Bearer Token，不影响）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
